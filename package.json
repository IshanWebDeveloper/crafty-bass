{
  "name": "crafty-bass",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "nx run-many -t build --all",
    "dev": "nx run-many -t dev --projects=frontend,admin,backend,ai-service --parallel=4",
    "dev:admin": "nx run admin:dev",
    "dev:ai": "nx run ai-service:dev",
    "dev:ai:uvicorn": "uvicorn --app-dir apps/ai-service app.main:app --reload --host 127.0.0.1 --port 8006",
    "lint": "nx run-many -t lint --all",
    "lint:staged": "lint-staged",
    "lint:commit": "commitlint --edit",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "nx run-many -t test --all",
    "test:cov": "nx run backend:test-cov && nx run validation:test-cov && nx run ai-service:test",
    "prisma:generate:all": "pnpm --filter @repo/db db:generate && node scripts/prisma/update-generated-prisma-stamp.mjs",
    "prisma:check:generated": "node scripts/prisma/check-generated-prisma-stamp.mjs",
    "affected:build": "nx affected -t build",
    "affected:lint": "nx affected -t lint",
    "affected:test": "nx affected -t test",
    "prepare": "husky",
    "stripe:listen": "stripe listen --forward-to http://localhost:3005/api/v1/payments/webhook"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^9.8.0",
    "@nx/devkit": "20.8.4",
    "@nx/eslint": "20.8.4",
    "@nx/eslint-plugin": "^20.8.4",
    "@nx/js": "20.8.4",
    "@nx/next": "20.8.4",
    "@nx/node": "20.8.4",
    "@nx/playwright": "20.8.4",
    "@nx/vite": "20.8.4",
    "@nx/web": "20.8.4",
    "@playwright/test": "^1.59.1",
    "@repo/eslint-config": "workspace:^",
    "@repo/prettier-config": "workspace:^",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "18.16.9",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.8.3",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^15.5.2",
    "nx": "^20.8.4",
    "prettier": "^3.7.4",
    "tslib": "^2.3.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,md,css,scss,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "node-fetch": "^2.7.0 || ^3.3.2"
      }
    },
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "msw"
    ],
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf",
      "nx",
      "sharp",
      "unrs-resolver"
    ]
  }
}
