# Example .env for crafty-bass (AI service)
# Copy this to apps/ai-service/.env and replace placeholders with your real keys.

# LLM provider (anthropic | openai)
LLM_PROVIDER=anthropic

# Anthropic API key (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_BASE_URL=

# OpenAI API key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=

# Optional overrides
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
APP_ENV=development
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8006
