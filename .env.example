# Example .env for crafty-bass (AI service)
# Copy this to .env and replace placeholders with your real tokens.

# LLM provider (ollama | openai | github)
LLM_PROVIDER=github

# GitHub model inference token (required if LLM_PROVIDER=github)
GITHUB_TOKEN=your_github_token_here

# OpenAI API key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=

# Optional overrides
GITHUB_INFERENCE_ENDPOINT=https://models.github.ai/inference
APP_ENV=development
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8006
