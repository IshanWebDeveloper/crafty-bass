# Copy to deploy/oracle/.env on the VM and fill in. Never commit the real file.
# docker-compose.yml derives the connection strings, auth URLs, CORS and the
# AI-service wiring from the values below - don't set those here.

# --- Domains (no https://) ---------------------------------------------------
# Public hostname that points at the VM's public IP (e.g. a free DuckDNS name).
API_DOMAIN=craftybass-api.duckdns.org
# Vercel hostnames for the two Next.js apps.
FRONTEND_DOMAIN=crafty-bass.vercel.app
ADMIN_DOMAIN=crafty-bass-admin.vercel.app

# --- Postgres (internal only) ------------------------------------------------
POSTGRES_USER=crafty
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=craftybass

# --- Auth --------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI service (LLM) --------------------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=

# --- Stripe (test mode is free) ----------------------------------------------
# Webhook endpoint: https://<API_DOMAIN>/api/v1/payments/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Crafty Bass <onboarding@resend.dev>

# --- File uploads (Cloudflare R2 / S3) ---------------------------------------
AWS_BUCKET_NAME=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
R2_ENDPOINT=
AWS_PRESIGNED_URL_EXPIRES_IN=3600
