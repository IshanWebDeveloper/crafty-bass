APP_NAME=Crafty Bass AI Service
APP_ENV=development
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8006
LLM_PROVIDER=anthropic
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Only set this to route through a gateway or proxy; blank uses the Anthropic API.
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_TEMPERATURE=0.2
# Output cap for every request. Too low silently truncates chat and translation.
LLM_MAX_TOKENS=4096

# Auth: required so that JWTs minted for other audiences/issuers cannot be replayed.
BETTER_AUTH_URL=http://localhost:3005
JWT_ISSUER=http://localhost:3005
JWT_AUDIENCE=ai-service
