APP_NAME=Crafty Bass AI Service
APP_ENV=development
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8006
LLM_PROVIDER=github
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GITHUB_TOKEN=
GITHUB_MODEL_NAME=openai/gpt-4o-mini
GITHUB_INFERENCE_ENDPOINT=https://models.github.ai/inference
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_TEMPERATURE=0.2

# Auth — required so that JWTs minted for other audiences/issuers cannot be replayed.
BETTER_AUTH_URL=http://localhost:3005
JWT_ISSUER=http://localhost:3005
JWT_AUDIENCE=ai-service
