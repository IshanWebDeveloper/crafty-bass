# Admin console (apps/admin) environment.
# Copy to .env for local overrides — never commit real .env files.

# Backend origin the same-origin /api/* proxy rewrites to (next.config.ts) and
# that server components reach directly for session/data (server-side only, not
# exposed to the browser). Defaults to the local backend when unset; set this to
# the deployed backend origin in production.
API_PROXY_TARGET=http://localhost:3005
