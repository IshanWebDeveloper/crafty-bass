{
  "name": "admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/admin",
  "sourceRoot": "apps/admin/src",
  "projectType": "application",
  "tags": ["type:app", "scope:admin"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/admin",
        "command": "next build"
      },
      "outputs": ["{projectRoot}/dist/**"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/admin",
        "command": "next dev --port 3001"
      },
      "cache": false
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/admin",
        "command": "next start --port 3001"
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/admin",
        "command": "eslint ."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/admin",
        "command": "echo No admin tests configured"
      }
    }
  }
}
