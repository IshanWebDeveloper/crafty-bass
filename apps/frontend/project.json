{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/frontend",
  "sourceRoot": "apps/frontend/src",
  "projectType": "application",
  "tags": ["type:app", "scope:web"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "pnpm build"
      },
      "outputs": ["{projectRoot}/.next/**", "!{projectRoot}/.next/cache/**"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "pnpm dev"
      },
      "cache": false
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "pnpm start"
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "pnpm lint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "pnpm test"
      }
    }
  }
}
