{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/frontend",
  "sourceRoot": "apps/frontend/src",
  "projectType": "application",
  "tags": ["type:app", "scope:web"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "next build"
      },
      "outputs": ["{projectRoot}/.next/**", "!{projectRoot}/.next/cache/**"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "next dev"
      },
      "cache": false
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "next start"
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "eslint ."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "echo No frontend tests configured"
      }
    }
  }
}
