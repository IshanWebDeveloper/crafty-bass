PORT=3005
# Prisma 7 connects via the node-postgres driver adapter (@repo/db).
# DATABASE_URL is the runtime connection; DIRECT_URL is used for migrations and
# any DDL routed via PRISMA_USE_DIRECT_URL=1 (e.g. Better Auth's CLI). On a single
# Postgres (no PgBouncer) both can point at the same database.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3005
# Claims emitted on JWTs minted via the `jwt` plugin. Downstream services
# (e.g. ai-service) must verify these match — see apps/ai-service/.env.example.
JWT_ISSUER=http://localhost:3005
JWT_AUDIENCE=ai-service
# Admin is served on the distinct `admin.localhost` host (not localhost:3001) so
# its better-auth session cookie is scoped to a different host than the frontend's
# — otherwise both apps share the localhost cookie jar (cookies ignore the port)
# and signing into one signs you out of the other. Open admin at
# http://admin.localhost:3001. localhost:3001 stays trusted for backwards compat.
CORS_ORIGINS=http://localhost:3000,http://admin.localhost:3001,http://localhost:3001,http://localhost:5173
# Set to "true" only when running local tooling (e.g. Postman) that cannot send
# CSRF tokens. Leave unset in every deployed environment.
# DISABLE_CSRF_CHECK=true
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Redis (use rediss:// for TLS — required by Upstash)
REDIS_URL=rediss://default:your_password@your-host.upstash.io:6379

# ─── Object storage (S3-compatible) ──────────────────────────────────────────
# Works with AWS S3 OR any S3-compatible provider (Cloudflare R2, MinIO,
# Backblaze B2). The var names stay AWS_* for both — only S3_ENDPOINT/region
# change. R2 has a free tier (10 GB + zero egress fees).
AWS_BUCKET_NAME=your_bucket_name
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_PRESIGNED_URL_EXPIRES_IN=3600

# Cloudflare R2 (recommended free alternative to AWS): set S3_ENDPOINT and use
# your R2 API token as the access key/secret. AWS_REGION should be "auto".
#   1. Cloudflare dashboard → R2 → create a bucket → put its name in AWS_BUCKET_NAME
#   2. R2 → Manage API Tokens → create an "Object Read & Write" token →
#      use the Access Key ID / Secret Access Key below
#   3. Endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_REGION=auto
# Optional: seed uploads remote product images into S3 under this key prefix
# Default: products/seeded
# SEED_PRODUCT_IMAGE_PREFIX=products/seeded
