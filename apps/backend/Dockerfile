# Build the docker image with `npx nx docker-build backend`.
# Tip: Modify "docker-build" options in project.json to change docker build args.
#
# Run the container with `docker run -p 3005:3005 -t backend`.
FROM docker.io/node:lts-alpine

ENV HOST=0.0.0.0
ENV PORT=3005

WORKDIR /app

RUN addgroup --system backend && \
          adduser --system -G backend backend

COPY apps/backend/package.json backend/package.json
COPY apps/backend/dist/ backend/
RUN chown -R backend:backend .

RUN npm install -g pnpm
RUN pnpm --dir backend install --prod --no-frozen-lockfile
RUN chown -R backend:backend .
USER backend

CMD [ "node", "backend/main.js" ]
