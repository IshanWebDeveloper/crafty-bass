{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "tags": ["type:app", "scope:api"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "nest build",
        "forwardAllArgs": false,
        "outputPath": "apps/backend/dist"
      },
      "outputs": ["{options.outputPath}/**"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "nest start --watch"
      },
      "cache": false
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "nest start"
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "eslint \"src/**/*.ts\" \"test/**/*.ts\""
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "dotenv -e .env.test -- jest"
      },
      "outputs": ["{projectRoot}/coverage/**"]
    },
    "docker-build": {
      "dependsOn": ["build"],
      "command": "docker build -f apps/backend/Dockerfile . -t backend"
    }
  }
}
