{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "tags": ["type:app", "scope:api"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "nest build",
        "forwardAllArgs": false,
        "outputPath": "apps/backend/dist"
      },
      "outputs": ["{options.outputPath}/**"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "nest start --watch"
      },
      "cache": false
    },
    "dev-built": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "nest build && dotenv -e .env -- node dist/main.js"
      },
      "cache": false
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "nest start"
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "eslint \"src/**/*.ts\" \"test/**/*.ts\""
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "commands": [
          "cross-env NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest",
          "dotenv -e .env.test -- vitest run"
        ],
        "parallel": false
      },
      "outputs": [
        "{projectRoot}/coverage/**",
        "{projectRoot}/coverage-vitest/**"
      ]
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "dotenv -e .env.test -- vitest run -c vitest.integration.config.ts"
      },
      "cache": false
    },
    "test-cov": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "commands": [
          "cross-env NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest --coverage",
          "dotenv -e .env.test -- vitest run --coverage"
        ],
        "parallel": false
      },
      "outputs": [
        "{projectRoot}/coverage/**",
        "{projectRoot}/coverage-vitest/**"
      ]
    },
    "docker-build": {
      "dependsOn": ["build"],
      "command": "docker build -f apps/backend/Dockerfile . -t backend"
    }
  }
}
