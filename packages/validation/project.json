{
  "name": "validation",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "packages/validation",
  "sourceRoot": "packages/validation/src",
  "projectType": "library",
  "tags": ["type:util", "scope:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/validation",
        "command": "pnpm build"
      },
      "outputs": ["{projectRoot}/dist/**"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/validation",
        "command": "pnpm lint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/validation",
        "command": "pnpm test"
      }
    }
  }
}
