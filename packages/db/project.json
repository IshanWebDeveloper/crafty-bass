{
  "name": "db",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "packages/db",
  "sourceRoot": "packages/db/src",
  "projectType": "library",
  "tags": ["type:util", "scope:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["db:generate"],
      "options": {
        "cwd": "packages/db",
        "command": "pnpm build"
      },
      "outputs": ["{projectRoot}/dist/**"]
    },
    "db:generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/db",
        "command": "pnpm db:generate"
      },
      "outputs": [
        "{projectRoot}/src/generated/**",
        "{workspaceRoot}/packages/shared-types/src/generated/**"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/db",
        "command": "pnpm lint"
      }
    }
  }
}
