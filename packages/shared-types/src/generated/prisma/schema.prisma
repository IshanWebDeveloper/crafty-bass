generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

generator sharedTypesClient {
  provider = "prisma-client-js"
  output   = "../../shared-types/src/generated/prisma"
}

// generator dbml {
//   provider = "prisma-dbml-generator"
//   output   = "../dbml"
// }

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SUPPORT
  ADMIN
}

enum UserType {
  HOMEOWNER
  TRADESMAN
}

enum LanguageCode {
  EN
  SI
  TA
}

enum JobStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum JobUrgency {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum ConversationType {
  JOB_DIRECT
  DIRECT
  SUPPORT
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  USER
  JOB
  QUOTE
  REVIEW
  MESSAGE
}

model User {
  id                      String    @id @default(cuid())
  name                    String
  email                   String    @unique
  emailVerified           Boolean   @default(false)
  image                   String?
  role                    Role      @default(CUSTOMER)
  userType                UserType?
  phone                   String?   @db.VarChar(32)
  stripeCustomerId        String?   @unique
  deletionScheduledAt     DateTime?
  privacyPolicyAcceptedAt DateTime
  banned                  Boolean   @default(false)
  banReason               String?
  banExpires              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  consents          UserConsent[]
  homeownerProfile  HomeownerProfile?
  tradesmanProfile  TradesmanProfile?
  postedJobs        Job[]                     @relation("HomeownerJobs")
  assignedJobs      Job[]                     @relation("AssignedTradesman")
  quotes            Quote[]                   @relation("TradesmanQuotes")
  sentMessages      Message[]                 @relation("SentMessages")
  receivedMessages  Message[]                 @relation("ReceivedMessages")
  reviewsGiven      Review[]                  @relation("ReviewsGiven")
  reviewsReceived   Review[]                  @relation("ReviewsReceived")
  createdReports    Report[]                  @relation("ReportsCreated")
  assignedReports   Report[]                  @relation("ReportsAssigned")
  recommendations   JobRecommendation[]       @relation("RecommendedTradesman")
  conversationLinks ConversationParticipant[]

  @@index([role])
  @@index([userType])
  @@index([createdAt])
  @@map("user")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([expiresAt])
  @@index([identifier])
  @@map("verification")
}

// Better Auth's JWT plugin stores rotating sign/verify key pairs here.
// Without this table the plugin fails at boot with
// `Model jwks does not exist in the database`, which 500s sign-in.
model Jwks {
  id         String    @id @default(cuid())
  publicKey  String    @db.Text
  privateKey String    @db.Text
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  @@map("jwks")
}

model UserConsent {
  id             String    @id @default(cuid())
  userId         String
  consentType    String
  granted        Boolean   @default(true)
  grantedAt      DateTime
  revokedAt      DateTime?
  consentVersion String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentType])
  @@index([consentType])
}

model HomeownerProfile {
  id                String       @id @default(cuid())
  userId            String       @unique
  locationText      String?
  city              String?
  district          String?
  postalCode        String?
  preferredLanguage LanguageCode @default(EN)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([district, city])
}

model TradesmanProfile {
  id                  String       @id @default(cuid())
  userId              String       @unique
  bio                 String?      @db.Text
  yearsExperience     Int          @default(0)
  hourlyRate          Decimal?     @db.Decimal(10, 2)
  locationText        String?
  city                String?
  district            String?
  latitude            Decimal?     @db.Decimal(9, 6)
  longitude           Decimal?     @db.Decimal(9, 6)
  serviceRadiusKm     Int          @default(15)
  avgRating           Decimal      @default(0) @db.Decimal(3, 2)
  ratingCount         Int          @default(0)
  jobsCompleted       Int          @default(0)
  jobsCancelled       Int          @default(0)
  responseTimeMinutes Int          @default(0)
  isVerified          Boolean      @default(false)
  isAvailable         Boolean      @default(true)
  preferredLanguage   LanguageCode @default(EN)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills TradesmanSkill[]

  @@index([district, city])
  @@index([isAvailable])
  @@index([avgRating])
}

model ServiceCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameEn      String
  nameSi      String?
  nameTa      String?
  description String?
  isActive    Boolean  @default(true)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent           ServiceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         ServiceCategory[] @relation("CategoryHierarchy")
  jobs             Job[]             @relation("PrimaryCategoryJobs")
  aiClassifiedJobs Job[]             @relation("AiPredictedCategory")
  skills           Skill[]

  @@index([parentId])
  @@index([isActive])
}

model Skill {
  id         String   @id @default(cuid())
  slug       String   @unique
  nameEn     String
  nameSi     String?
  nameTa     String?
  categoryId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category  ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tradesmen TradesmanSkill[]
  jobs      JobSkill[]

  @@index([categoryId])
}

model TradesmanSkill {
  tradesmanProfileId String
  skillId            String
  yearsExperience    Int      @default(0)
  isPrimary          Boolean  @default(false)
  createdAt          DateTime @default(now())

  tradesmanProfile TradesmanProfile @relation(fields: [tradesmanProfileId], references: [id], onDelete: Cascade)
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([tradesmanProfileId, skillId])
  @@index([skillId])
}

model Job {
  id                  String       @id @default(cuid())
  homeownerId         String
  title               String
  description         String       @db.Text
  descriptionLanguage LanguageCode @default(EN)
  categoryId          String?
  aiCategoryId        String?
  aiConfidence        Decimal?     @db.Decimal(5, 4)
  aiSuggestedTags     Json?
  locationText        String?
  city                String?
  district            String?
  latitude            Decimal?     @db.Decimal(9, 6)
  longitude           Decimal?     @db.Decimal(9, 6)
  budgetMin           Decimal?     @db.Decimal(10, 2)
  budgetMax           Decimal?     @db.Decimal(10, 2)
  scheduledFor        DateTime?
  urgency             JobUrgency   @default(MEDIUM)
  status              JobStatus    @default(OPEN)
  assignedTradesmanId String?
  acceptedQuoteId     String?      @unique
  completedAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  homeowner         User                @relation("HomeownerJobs", fields: [homeownerId], references: [id], onDelete: Cascade)
  category          ServiceCategory?    @relation("PrimaryCategoryJobs", fields: [categoryId], references: [id], onDelete: SetNull)
  aiCategory        ServiceCategory?    @relation("AiPredictedCategory", fields: [aiCategoryId], references: [id], onDelete: SetNull)
  assignedTradesman User?               @relation("AssignedTradesman", fields: [assignedTradesmanId], references: [id], onDelete: SetNull)
  acceptedQuote     Quote?              @relation("AcceptedQuote", fields: [acceptedQuoteId], references: [id], onDelete: SetNull)
  quotes            Quote[]
  skills            JobSkill[]
  conversations     Conversation[]
  reviews           Review[]
  recommendations   JobRecommendation[]
  reports           Report[]

  @@index([homeownerId, status])
  @@index([status, categoryId])
  @@index([district, city])
  @@index([assignedTradesmanId])
  @@index([createdAt])
}

model JobSkill {
  jobId      String
  skillId    String
  confidence Decimal? @db.Decimal(5, 4)
  source     String   @default("manual")

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@index([skillId])
}

model Quote {
  id                  String      @id @default(cuid())
  jobId               String
  tradesmanId         String
  amount              Decimal     @db.Decimal(10, 2)
  currency            String      @default("LKR")
  message             String?     @db.Text
  estimatedStart      DateTime?
  estimatedCompletion DateTime?
  status              QuoteStatus @default(PENDING)
  respondedAt         DateTime?
  withdrawnAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  job            Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tradesman      User @relation("TradesmanQuotes", fields: [tradesmanId], references: [id], onDelete: Cascade)
  acceptedForJob Job? @relation("AcceptedQuote")

  @@unique([jobId, tradesmanId])
  @@index([tradesmanId, status])
  @@index([jobId, status])
}

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType @default(JOB_DIRECT)
  jobId         String?
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  job          Job?                      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([jobId])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  recipientId    String?
  body           String      @db.Text
  messageType    MessageType @default(TEXT)
  attachments    Json?
  isRead         Boolean     @default(false)
  readAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User?        @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: SetNull)
  reports      Report[]

  @@index([conversationId, createdAt])
  @@index([recipientId, isRead])
}

model Review {
  id         String   @id @default(cuid())
  jobId      String
  reviewerId String
  revieweeId String
  rating     Int
  title      String?
  comment    String?  @db.Text
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewer User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  reports  Report[]

  @@unique([jobId, reviewerId, revieweeId])
  @@index([revieweeId, rating])
}

model JobRecommendation {
  id          String   @id @default(cuid())
  jobId       String
  tradesmanId String
  score       Decimal  @db.Decimal(5, 4)
  rank        Int
  reasons     Json?
  snapshot    Json?
  createdAt   DateTime @default(now())

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tradesman User @relation("RecommendedTradesman", fields: [tradesmanId], references: [id], onDelete: Cascade)

  @@unique([jobId, tradesmanId])
  @@index([jobId, rank])
  @@index([tradesmanId])
}

model Report {
  id              String           @id @default(cuid())
  reporterId      String
  assigneeId      String?
  targetType      ReportTargetType
  targetId        String
  reason          String           @db.Text
  status          ReportStatus     @default(OPEN)
  resolutionNotes String?          @db.Text
  resolvedAt      DateTime?
  jobId           String?
  messageId       String?
  reviewId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  reporter User     @relation("ReportsCreated", fields: [reporterId], references: [id], onDelete: Cascade)
  assignee User?    @relation("ReportsAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)
  job      Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  review   Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([assigneeId])
}

enum WebhookEventStatus {
  RECEIVED
  ACCEPTED
  IGNORED
  PROCESSED
  FAILED
  REJECTED
}

// Audit trail for inbound third-party webhooks. A row is created on entry
// (RECEIVED) and mark()-ed before each return, including on rejection, so the
// admin surface has a complete record. Wired into the marketplace Stripe Connect
// payout webhook when that is built (Phase C).
model WebhookEvent {
  id          String             @id @default(cuid())
  source      String
  eventType   String
  status      WebhookEventStatus @default(RECEIVED)
  signature   String?
  payload     Json
  error       String?            @db.Text
  createdAt   DateTime           @default(now())
  processedAt DateTime?

  @@index([source, status])
  @@index([createdAt])
}
