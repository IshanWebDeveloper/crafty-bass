generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

generator sharedTypesClient {
  provider = "prisma-client-js"
  output   = "../../shared-types/src/generated/prisma"
}

// generator dbml {
//   provider = "prisma-dbml-generator"
//   output   = "../dbml"
// }

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SUPPORT
  ADMIN
}

enum UserType {
  HOMEOWNER
  TRADESMAN
}

enum LanguageCode {
  EN
  SI
  TA
}

enum JobStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  // A party raised a report/complaint against an in-progress job. Work is paused
  // and the job is out of IN_PROGRESS while support reviews and decides whether
  // to cancel + refund or let it resume. Set in ReportsService.create.
  DISPUTED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum JobUrgency {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

// Rough size of a job, used to set duration expectations when posting.
enum TaskSize {
  SMALL
  MEDIUM
  LARGE
}

// Whether the job needs the tradesperson to bring a vehicle (e.g. moving,
// hauling away waste). Helps homeowners surface trades equipped for the work.
enum VehicleRequirement {
  NONE
  CAR
  TRUCK
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

// A tradesman's mid-job request for extra materials/tools, awaiting the
// homeowner's decision.
enum MaterialRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

// Whether a quote line is labour or a material/part. The quote total is built up
// from these lines (plus call-out/discount/VAT).
enum QuoteLineCategory {
  LABOUR
  MATERIAL
}

// Materials-deposit escrow lifecycle. Mirrors the homeowner-facing milestone
// strip: FUNDED (held) -> MATERIALS_RELEASED (paid out to buy parts when work
// starts) -> WORK_COMPLETED (job done) -> RELEASED (balance paid out). REQUESTED
// is the pre-funding state (tradesman asked on the quote); REFUNDED/CANCELLED are
// the exits before release.
enum EscrowStatus {
  REQUESTED
  FUNDED
  MATERIALS_RELEASED
  WORK_COMPLETED
  RELEASED
  REFUNDED
  CANCELLED
}

enum EscrowTransactionType {
  FUND
  RELEASE_MATERIALS
  RELEASE_BALANCE
  REFUND
}

// Tradesman KYC verification submission. A tradesman submits one (PENDING); an
// admin/support reviewer approves it (flips TradesmanProfile.isVerified, and
// backgroundChecked when a police-clearance document is attached) or rejects it.
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversationType {
  JOB_DIRECT
  DIRECT
  SUPPORT
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  USER
  JOB
  QUOTE
  REVIEW
  MESSAGE
}

// In-app notification kinds. JOB_EXPIRING warns relevant tradesmen that an OPEN
// job matching their trade is about to lapse (see JobExpiryNoticeCronService).
// The rest track a job through its lifecycle so both parties are told when the
// status they care about changes (see NotificationsService dispatch methods):
//   QUOTE_ACCEPTED / QUOTE_DECLINED — a tradesman won / wasn't picked for a job
//   ESCROW_FUNDED   — homeowner funded the deposit; the tradesman can start
//   WORK_STARTED    — the tradesman started the work (job → IN_PROGRESS)
//   WORK_COMPLETED  — the tradesman marked work done; awaiting homeowner approval
//   JOB_COMPLETED   — the homeowner approved; the balance was released
//   JOB_CANCELLED   — the homeowner cancelled an assigned job
//   JOB_EXPIRED     — an open job lapsed without being assigned
// Kept as an enum so new notification types are added deliberately.
enum NotificationType {
  JOB_EXPIRING
  QUOTE_ACCEPTED
  QUOTE_DECLINED
  ESCROW_FUNDED
  WORK_STARTED
  WORK_COMPLETED
  JOB_COMPLETED
  JOB_CANCELLED
  JOB_EXPIRED
}

model User {
  id                      String    @id @default(cuid())
  name                    String
  email                   String    @unique
  emailVerified           Boolean   @default(false)
  image                   String?
  role                    Role      @default(CUSTOMER)
  userType                UserType?
  phone                   String?   @db.VarChar(32)
  stripeCustomerId        String?   @unique
  deletionScheduledAt     DateTime?
  privacyPolicyAcceptedAt DateTime
  banned                  Boolean   @default(false)
  banReason               String?
  banExpires              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  consents              UserConsent[]
  homeownerProfile      HomeownerProfile?
  tradesmanProfile      TradesmanProfile?
  postedJobs            Job[]                     @relation("HomeownerJobs")
  assignedJobs          Job[]                     @relation("AssignedTradesman")
  quotes                Quote[]                   @relation("TradesmanQuotes")
  materialRequests      MaterialRequest[]         @relation("TradesmanMaterialRequests")
  sentMessages          Message[]                 @relation("SentMessages")
  receivedMessages      Message[]                 @relation("ReceivedMessages")
  reviewsGiven          Review[]                  @relation("ReviewsGiven")
  reviewsReceived       Review[]                  @relation("ReviewsReceived")
  createdReports        Report[]                  @relation("ReportsCreated")
  assignedReports       Report[]                  @relation("ReportsAssigned")
  recommendations       JobRecommendation[]       @relation("RecommendedTradesman")
  conversationLinks     ConversationParticipant[]
  escrowsAsHomeowner    JobEscrow[]               @relation("EscrowHomeowner")
  escrowsAsTradesman    JobEscrow[]               @relation("EscrowTradesman")
  verification          TradesmanVerification?    @relation("TradesmanVerification")
  reviewedVerifications TradesmanVerification[]   @relation("VerificationReviewer")
  notifications         Notification[]
  auditLogs             AuditLog[]                @relation("AuditLogActor")

  phoneNumber         String?
  phoneNumberVerified Boolean?

  @@unique([phoneNumber])
  @@index([role])
  @@index([userType])
  @@index([createdAt])
  @@map("user")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([expiresAt])
  @@index([identifier])
  @@map("verification")
}

// Better Auth's JWT plugin stores rotating sign/verify key pairs here.
// Without this table the plugin fails at boot with
// `Model jwks does not exist in the database`, which 500s sign-in.

model Jwks {
  id         String    @id @default(cuid())
  publicKey  String    @db.Text
  privateKey String    @db.Text
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  @@map("jwks")
}

model UserConsent {
  id             String    @id @default(cuid())
  userId         String
  consentType    String
  granted        Boolean   @default(true)
  grantedAt      DateTime
  revokedAt      DateTime?
  consentVersion String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentType])
  @@index([consentType])
}

model HomeownerProfile {
  id                String       @id @default(cuid())
  userId            String       @unique
  locationText      String?
  city              String?
  district          String?
  postalCode        String?
  preferredLanguage LanguageCode @default(EN)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([district, city])
}

model TradesmanProfile {
  id                  String       @id @default(cuid())
  userId              String       @unique
  bio                 String?      @db.Text
  yearsExperience     Int          @default(0)
  hourlyRate          Decimal?     @db.Decimal(10, 2)
  locationText        String?
  city                String?
  district            String?
  latitude            Decimal?     @db.Decimal(9, 6)
  longitude           Decimal?     @db.Decimal(9, 6)
  serviceRadiusKm     Int          @default(15)
  avgRating           Decimal      @default(0) @db.Decimal(3, 2)
  ratingCount         Int          @default(0)
  jobsCompleted       Int          @default(0)
  jobsCancelled       Int          @default(0)
  responseTimeMinutes Int          @default(0)
  isVerified          Boolean      @default(false)
  backgroundChecked   Boolean      @default(false)
  isAvailable         Boolean      @default(true)
  preferredLanguage   LanguageCode @default(EN)
  // Free-text professional certifications/licences and vehicles the tradesman
  // lists on their profile so homeowners can gauge qualifications and logistics.
  certifications      String[]     @default([])
  vehicles            String[]     @default([])
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills TradesmanSkill[]

  @@index([district, city])
  @@index([isAvailable])
  @@index([avgRating])
}

model ServiceCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameEn      String
  nameSi      String?
  nameTa      String?
  description String?
  isActive    Boolean  @default(true)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent           ServiceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         ServiceCategory[] @relation("CategoryHierarchy")
  jobs             Job[]             @relation("PrimaryCategoryJobs")
  aiClassifiedJobs Job[]             @relation("AiPredictedCategory")
  skills           Skill[]

  @@index([parentId])
  @@index([isActive])
}

model Skill {
  id         String   @id @default(cuid())
  slug       String   @unique
  nameEn     String
  nameSi     String?
  nameTa     String?
  categoryId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category  ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tradesmen TradesmanSkill[]
  jobs      JobSkill[]

  @@index([categoryId])
}

model TradesmanSkill {
  tradesmanProfileId String
  skillId            String
  yearsExperience    Int      @default(0)
  isPrimary          Boolean  @default(false)
  createdAt          DateTime @default(now())

  tradesmanProfile TradesmanProfile @relation(fields: [tradesmanProfileId], references: [id], onDelete: Cascade)
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([tradesmanProfileId, skillId])
  @@index([skillId])
}

model Job {
  id                  String              @id @default(cuid())
  homeownerId         String
  title               String
  description         String              @db.Text
  descriptionLanguage LanguageCode        @default(EN)
  categoryId          String?
  aiCategoryId        String?
  aiConfidence        Decimal?            @db.Decimal(5, 4)
  aiSuggestedTags     Json?
  locationText        String?
  city                String?
  district            String?
  latitude            Decimal?            @db.Decimal(9, 6)
  longitude           Decimal?            @db.Decimal(9, 6)
  budgetMin           Decimal?            @db.Decimal(10, 2)
  budgetMax           Decimal?            @db.Decimal(10, 2)
  scheduledFor        DateTime?
  urgency             JobUrgency          @default(MEDIUM)
  taskSize            TaskSize?
  vehicleRequirement  VehicleRequirement?
  status              JobStatus           @default(OPEN)
  assignedTradesmanId String?
  acceptedQuoteId     String?             @unique
  // When an OPEN job stops accepting quotes, derived from urgency at creation. A
  // cron flips lapsed OPEN jobs to EXPIRED; the UI flags those nearing this time.
  expiresAt           DateTime?
  // Set once the "job about to expire" notices have been dispatched to relevant
  // tradesmen, so the notice cron fires at most once per job (see
  // JobExpiryNoticeCronService).
  expiryNoticeSentAt  DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  homeowner         User                @relation("HomeownerJobs", fields: [homeownerId], references: [id], onDelete: Cascade)
  category          ServiceCategory?    @relation("PrimaryCategoryJobs", fields: [categoryId], references: [id], onDelete: SetNull)
  aiCategory        ServiceCategory?    @relation("AiPredictedCategory", fields: [aiCategoryId], references: [id], onDelete: SetNull)
  assignedTradesman User?               @relation("AssignedTradesman", fields: [assignedTradesmanId], references: [id], onDelete: SetNull)
  acceptedQuote     Quote?              @relation("AcceptedQuote", fields: [acceptedQuoteId], references: [id], onDelete: SetNull)
  quotes            Quote[]
  skills            JobSkill[]
  conversations     Conversation[]
  reviews           Review[]
  recommendations   JobRecommendation[]
  reports           Report[]
  escrow            JobEscrow?
  materialRequests  MaterialRequest[]
  notifications     Notification[]

  @@index([homeownerId, status])
  @@index([status, categoryId])
  @@index([district, city])
  @@index([assignedTradesmanId])
  @@index([createdAt])
  @@index([status, expiresAt])
}

model JobSkill {
  jobId      String
  skillId    String
  confidence Decimal? @db.Decimal(5, 4)
  source     String   @default("manual")

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@index([skillId])
}

model Quote {
  id                  String      @id @default(cuid())
  jobId               String
  tradesmanId         String
  // Grand total, derived server-side from the line items plus the call-out fee,
  // discount and VAT. materialsAmount is the sum of MATERIAL lines (used to cap
  // the escrow deposit).
  amount              Decimal     @db.Decimal(10, 2)
  materialsAmount     Decimal?    @db.Decimal(10, 2)
  calloutFee          Decimal?    @db.Decimal(10, 2)
  discount            Decimal?    @db.Decimal(10, 2)
  vatRate             Decimal?    @db.Decimal(5, 2)
  depositRequested    Decimal?    @db.Decimal(10, 2)
  currency            String      @default("LKR")
  message             String?     @db.Text
  estimatedStart      DateTime?
  estimatedCompletion DateTime?
  // The quote lapses after this; a cron flips pending quotes past it to EXPIRED.
  validUntil          DateTime?
  status              QuoteStatus @default(PENDING)
  respondedAt         DateTime?
  withdrawnAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  job            Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tradesman      User            @relation("TradesmanQuotes", fields: [tradesmanId], references: [id], onDelete: Cascade)
  acceptedForJob Job?            @relation("AcceptedQuote")
  escrow         JobEscrow?
  materials      QuoteMaterial[]

  @@unique([jobId, tradesmanId])
  @@index([tradesmanId, status])
  @@index([jobId, status])
}

// An itemised material/tool line on a quote so the homeowner sees the scope and
// estimated costs behind the price. Descriptive only — the deposit/escrow figure
// is the quote's materialsAmount; unitPrice here is the tradesman's estimate.
// A single line on a quote — labour or a material/part. The quote total is
// built up from these (see Quote.amount). Despite the model name it now holds
// both labour and material lines, distinguished by `category`.
model QuoteMaterial {
  id        String            @id @default(cuid())
  quoteId   String
  category  QuoteLineCategory @default(MATERIAL)
  name      String
  quantity  Decimal           @default(1) @db.Decimal(10, 2)
  // Unit of measurement for the quantity (e.g. kg, m, m², pcs, fitting, job).
  unit      String?
  unitPrice Decimal?          @db.Decimal(10, 2)
  createdAt DateTime          @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

// A request from the assigned tradesman for additional materials/tools partway
// through a job. The homeowner approves or declines it. `estimatedCost` is the
// tradesman's optional estimate; settling payment is out of scope here.
model MaterialRequest {
  id            String                @id @default(cuid())
  jobId         String
  requestedById String
  note          String                @db.Text
  estimatedCost Decimal?              @db.Decimal(10, 2)
  currency      String                @default("LKR")
  status        MaterialRequestStatus @default(PENDING)
  respondedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  job         Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requestedBy User @relation("TradesmanMaterialRequests", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([requestedById])
}

// One escrow per accepted quote that requested a materials deposit. Crafty Bass
// holds the deposit (never the tradesman); the balance is settled on completion.
// Amounts are snapshotted from the quote at acceptance so later quote edits can't
// move money. The transactions[] ledger is the audit trail of fund/release/refund.
model JobEscrow {
  id                    String       @id @default(cuid())
  jobId                 String       @unique
  quoteId               String       @unique
  homeownerId           String
  tradesmanId           String
  currency              String       @default("LKR")
  quoteTotal            Decimal      @db.Decimal(10, 2)
  materialsAmount       Decimal      @db.Decimal(10, 2)
  depositAmount         Decimal      @db.Decimal(10, 2)
  balanceAmount         Decimal      @db.Decimal(10, 2)
  status                EscrowStatus @default(REQUESTED)
  paymentMethod         String?
  paymentRef            String?
  stripePaymentIntentId String?      @unique
  fundedAt              DateTime?
  materialsReleasedAt   DateTime?
  workCompletedAt       DateTime?
  releasedAt            DateTime?
  refundedAt            DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  job          Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  quote        Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  homeowner    User                @relation("EscrowHomeowner", fields: [homeownerId], references: [id], onDelete: Cascade)
  tradesman    User                @relation("EscrowTradesman", fields: [tradesmanId], references: [id], onDelete: Cascade)
  transactions EscrowTransaction[]

  @@index([homeownerId])
  @@index([tradesmanId])
  @@index([status])
}

model EscrowTransaction {
  id        String                @id @default(cuid())
  escrowId  String
  type      EscrowTransactionType
  amount    Decimal               @db.Decimal(10, 2)
  note      String?
  createdAt DateTime              @default(now())

  escrow JobEscrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@index([escrowId])
}

// One KYC submission per tradesman (resubmittable while not approved). Document
// fields hold storage references (keys/URLs) — the actual binary upload is a
// separate concern. Sensitive fields (NIC, payout) are never exposed to
// homeowners; only the submitting tradesman and reviewers can read them.
model TradesmanVerification {
  id     String             @id @default(cuid())
  userId String             @unique
  status VerificationStatus @default(PENDING)

  // Identity
  fullName    String
  gender      String?
  dateOfBirth DateTime?
  nicNumber   String

  // Address
  addressLine String?
  city        String?
  district    String?

  // Trade
  primaryTrade    String?
  yearsExperience Int     @default(0)

  // Document references (storage keys/URLs)
  nicFrontKey        String?
  nicBackKey         String?
  photoKey           String?
  gramaNiladhariKey  String?
  licenceKey         String?
  licenceNumber      String?
  policeClearanceKey String? // presence unlocks the Background-checked tier

  // Work details
  serviceRadiusKm Int     @default(15)
  crewType        String? // solo | team
  helperCount     Int?
  portfolioKeys   Json? // string[]
  guarantorName   String?
  guarantorNic    String?
  voiceIntroKey   String?

  // Payout (sensitive)
  payoutAccountHolder String?
  payoutBank          String?
  payoutBranch        String?
  payoutAccountNumber String?

  // Review
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User  @relation("TradesmanVerification", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reviewedById])
}

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType @default(JOB_DIRECT)
  jobId         String?
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  job          Job?                      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([jobId])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  recipientId    String?
  body           String      @db.Text
  messageType    MessageType @default(TEXT)
  attachments    Json?
  isRead         Boolean     @default(false)
  readAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User?        @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: SetNull)
  reports      Report[]

  @@index([conversationId, createdAt])
  @@index([recipientId, isRead])
}

model Review {
  id         String   @id @default(cuid())
  jobId      String
  reviewerId String
  revieweeId String
  rating     Int
  title      String?
  comment    String?  @db.Text
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewer User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  reports  Report[]

  @@unique([jobId, reviewerId, revieweeId])
  @@index([revieweeId, rating])
}

model JobRecommendation {
  id          String   @id @default(cuid())
  jobId       String
  tradesmanId String
  score       Decimal  @db.Decimal(5, 4)
  rank        Int
  reasons     Json?
  snapshot    Json?
  createdAt   DateTime @default(now())

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tradesman User @relation("RecommendedTradesman", fields: [tradesmanId], references: [id], onDelete: Cascade)

  @@unique([jobId, tradesmanId])
  @@index([jobId, rank])
  @@index([tradesmanId])
}

model Report {
  id              String           @id @default(cuid())
  reporterId      String
  assigneeId      String?
  targetType      ReportTargetType
  targetId        String
  reason          String           @db.Text
  status          ReportStatus     @default(OPEN)
  resolutionNotes String?          @db.Text
  resolvedAt      DateTime?
  jobId           String?
  messageId       String?
  reviewId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  reporter User     @relation("ReportsCreated", fields: [reporterId], references: [id], onDelete: Cascade)
  assignee User?    @relation("ReportsAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)
  job      Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  review   Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([assigneeId])
}

// An in-app notification for a single user. The bell and notifications centre
// read these; `readAt` tracks the unread badge. `href` is an app-relative deep
// link (e.g. "jobs/<id>"); `jobId` links to the originating job for cascade
// delete and dedup. Dynamic copy (title/body) is stored in English — the
// surrounding chrome is localised on the client.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?          @db.Text
  href      String?
  jobId     String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // One notification of a given type per user per job — lets the expiry-notice
  // dispatch use createMany(skipDuplicates) safely if it ever re-runs.
  @@unique([userId, type, jobId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum WebhookEventStatus {
  RECEIVED
  ACCEPTED
  IGNORED
  PROCESSED
  FAILED
  REJECTED
}

// Audit trail for inbound third-party webhooks. A row is created on entry
// (RECEIVED) and mark()-ed before each return, including on rejection, so the
// admin surface has a complete record. Wired into the marketplace Stripe Connect
// payout webhook when that is built (Phase C).

model WebhookEvent {
  id          String             @id @default(cuid())
  source      String
  eventType   String
  status      WebhookEventStatus @default(RECEIVED)
  signature   String?
  payload     Json
  error       String?            @db.Text
  createdAt   DateTime           @default(now())
  processedAt DateTime?

  @@index([source, status])
  @@index([createdAt])
}

// Admin action audit trail. Every privileged mutation (ban, role change, user
// creation, moderation decision) writes a row here so the admin console has a
// tamper-evident history of who did what. actorId is nullable + SetNull so the
// trail survives even if the acting staff account is later removed.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
}
